{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extSubTitle__",
  "default_locale": "en",
  "permissions": [
    "bookmarks",
    "storage",
    "history",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BookmarkFlow",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
